---
layout: base.njk
title: 문의하기
section: contact
permalink: /contact/
---
<section class="ph">
  <div class="wrap ph-in solo">
    <span class="crumb">홈 › 문의하기</span>
    <h1>문의하기</h1>
    <p>사업 협력, 회원 가입, 교육·포럼 참여 등 궁금한 점을 남겨 주세요. 남겨 주신 이메일로 답변드립니다.</p>
  </div>
</section>

<section class="wrap sec">
  <div class="contact">
    <form id="contact-form" class="cf" action="/api/contact" method="post" novalidate>
      <div class="cf-row">
        <label class="cf-field">
          <span>작성자 <em>필수</em></span>
          <input type="text" name="name" maxlength="50" autocomplete="name" required>
        </label>
        <label class="cf-field">
          <span>연락처 <em>필수</em></span>
          <input type="tel" name="phone" maxlength="40" autocomplete="tel" required>
        </label>
      </div>
      <label class="cf-field">
        <span>이메일 <em>필수</em></span>
        <input type="email" name="email" maxlength="120" autocomplete="email" required placeholder="답변 받을 이메일 주소">
      </label>
      <label class="cf-field">
        <span>제목 <em>필수</em></span>
        <input type="text" name="subject" maxlength="120" required>
      </label>
      <label class="cf-field">
        <span>내용 <em>필수</em></span>
        <textarea name="message" rows="8" maxlength="5000" required></textarea>
      </label>

      <!-- 스팸 방지용 칸: 사람에게는 보이지 않습니다 -->
      <div class="cf-trap" aria-hidden="true">
        <label>홈페이지 <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      </div>
      <input type="hidden" name="t" value="">

      <div class="cf-agree">
        <p><b>개인정보 수집·이용 안내</b><br>
        수집 항목: 작성자, 연락처, 이메일 · 이용 목적: 문의 답변 · 보유 기간: 답변 완료 후 1년, 이후 파기<br>
        동의하지 않으실 수 있으며, 이 경우 양식 대신 이메일({{ site.email }})로 문의해 주세요. <a href="/privacy/">개인정보처리방침</a></p>
        <label class="cf-check"><input type="checkbox" name="agree" value="yes" required> 위 내용에 동의합니다. <em>필수</em></label>
      </div>

      <p class="cf-msg" id="cf-msg" role="status" aria-live="polite"></p>
      <button type="submit" class="btn cf-send">전송</button>
    </form>

    <aside class="cf-side">
      <div><small>이메일</small><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      <div><small>주소</small>{{ site.address }}</div>
      <p class="muted">보내 주신 문의는 담당자 이메일로 바로 전달됩니다.</p>
    </aside>
  </div>
</section>

<script>
(function () {
  var f = document.getElementById("contact-form");
  var msg = document.getElementById("cf-msg");
  var btn = f.querySelector(".cf-send");
  f.t.value = String(Date.now());
  function say(text, ok) { msg.textContent = text; msg.className = "cf-msg " + (ok ? "ok" : "err"); }
  f.addEventListener("submit", async function (e) {
    e.preventDefault();
    var need = ["name", "phone", "email", "subject", "message"];
    for (var i = 0; i < need.length; i++) {
      if (!f[need[i]].value.trim()) { say("필수 항목을 모두 입력해 주세요."); f[need[i]].focus(); return; }
    }
    if (!f.email.checkValidity()) { say("이메일 주소를 다시 확인해 주세요."); f.email.focus(); return; }
    if (!f.agree.checked) { say("개인정보 수집·이용에 동의해 주세요."); f.agree.focus(); return; }
    btn.disabled = true; btn.textContent = "보내는 중…"; say("");
    try {
      var res = await fetch(f.action, { method: "POST", body: new FormData(f) });
      var data = await res.json().catch(function () { return {}; });
      if (res.ok && data.ok) {
        f.reset(); f.t.value = String(Date.now());
        say("문의가 전송되었습니다. 남겨 주신 이메일로 답변드리겠습니다.", true);
      } else {
        say(data.error || "전송하지 못했습니다. 잠시 뒤 다시 시도해 주세요.");
      }
    } catch (err) {
      say("인터넷 연결을 확인한 뒤 다시 시도해 주세요.");
    }
    btn.disabled = false; btn.textContent = "전송";
  });
})();
</script>
