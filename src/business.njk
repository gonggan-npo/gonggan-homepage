---
layout: base.njk
title: 주요사업
section: business
permalink: /business/
---
<section class="ph{% if images.business %} has-img{% endif %}"{% if images.business %} style="--img: url('{{ images.business }}')"{% endif %}>
  <div class="wrap ph-in">
    <span class="crumb">홈 › 주요사업</span>
    <h1>주요사업</h1>
    <p>지식과 실천을 잇는 여섯 가지 사업으로 경남의 공간을 다시 사람으로 채웁니다.</p>
    <nav class="tabs" aria-label="주요사업 하위 메뉴">
      <a href="#overview">사업 개요</a>
      <a href="#core">핵심사업</a>
      <a href="#flagship">대표 사업</a>
      <a href="#roadmap">로드맵</a>
      <a href="#research">자료·공고·사례</a>
    </nav>
  </div>
</section>

<section id="overview" class="wrap sec">
  <div class="stack">
    <p class="eyebrow">사업 개요</p>
    <h2 class="h2">6대 핵심 사업</h2>
  </div>
  <div class="list-top">
    {%- for b in business %}
    <a href="#biz-{{ loop.index }}" class="row row-link"><span class="num">{{ loop.index }}</span><b>{{ b.name }}</b><p>{{ b.desc }}</p><span class="go" aria-hidden="true">↓</span></a>
    {%- endfor %}
  </div>
</section>

<section id="core" class="wrap sec">
  <div class="stack">
    <p class="eyebrow">핵심사업</p>
    <h2 class="h2">무엇을 하나요</h2>
  </div>
  <div class="biz-list">
    {%- for c in bizplan.core %}
    <article class="biz" id="biz-{{ loop.index }}">
      <div class="biz-head">
        <span class="num">{{ loop.index }}</span>
        <div>
          <span class="biz-kicker">{{ business[loop.index0].name }}</span>
          <h3>{{ c.title }}</h3>
        </div>
      </div>
      <div class="biz-items">
        {%- for it in c.items %}
        <div class="biz-item">
          <b>{{ it.h }}</b>
          <ul>{% for d in it.d %}<li>{{ d }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
      </div>
    </article>
    {%- endfor %}
  </div>
</section>

<section id="flagship" class="mint">
  <div class="wrap sec" style="border-bottom: 0">
    <div class="stack">
      <p class="eyebrow">대표 사업</p>
      <h2 class="h2">3대 핵심 프로젝트</h2>
    </div>
    <div class="flags">
      {%- for f in bizplan.flagship %}
      <article class="flag">
        <span class="flag-stage">{{ f.stage }}</span>
        <h3>{{ f.title }}</h3>
        <p class="muted flag-sub">{{ f.sub }}</p>
        <p>{{ f.goal }}</p>
        <details>
          <summary>주요 추진내용 보기</summary>
          <ol>{% for st in f.steps %}<li>{{ st }}</li>{% endfor %}</ol>
          <p class="flag-effect"><b>기대효과</b> {{ f.effect }}</p>
        </details>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section id="roadmap" class="wrap sec">
  <div class="stack">
    <p class="eyebrow">로드맵</p>
    <h2 class="h2">이렇게 걸어갑니다</h2>
  </div>
  <div class="road">
    {%- for r in bizplan.roadmap %}
    <div class="road-step">
      <span class="road-dot">{{ loop.index }}</span>
      <span class="flag-stage">{{ r.stage }}</span>
      <h3>{{ r.title }}</h3>
      <ul>{% for i in r.items %}<li>{{ i }}</li>{% endfor %}</ul>
    </div>
    {%- endfor %}
  </div>
</section>

<section id="research" class="wrap sec">
  <div class="stack">
    <p class="eyebrow">연구·정책</p>
    <h2 class="h2">연구보고서와 정책제안</h2>
  </div>
  {%- if collections.research.length %}
  <div class="scroll-x">
    <table>
      <thead><tr><th style="width: 120px">분류</th><th>제목</th><th style="width: 110px">발간</th><th style="width: 90px">자료</th></tr></thead>
      <tbody>
        {%- for r in collections.research %}
        <tr>
          <td><span class="tag">{{ r.data.kind }}</span></td>
          <td><b>{{ r.data.title }}</b>{% if r.data.summary %}<br><span class="muted" style="font-size: 14px">{{ r.data.summary }}</span>{% endif %}</td>
          <td class="muted">{{ r.date | ym }}</td>
          <td>{% if r.data.file %}<a href="{{ r.data.file }}" target="_blank" rel="noopener" style="color: var(--accent); font-weight: 500">PDF ↓</a>{% endif %}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- else %}
  <p class="empty">연구 자료를 준비하고 있습니다.</p>
  {%- endif %}
</section>

<section id="edu" class="wrap sec">
  <div class="stack">
    <p class="eyebrow">인재 양성·교육</p>
    <h2 class="h2">교육 프로그램과 모집 공고</h2>
  </div>
  {%- if collections.programs.length %}
  <div class="cards">
    {%- for p in collections.programs %}
    <a href="{{ p.url }}" class="card">
      <span class="st {% if p.data.status == '모집 중' %}on{% else %}off{% endif %}" style="align-self: flex-start">{{ p.data.status }}</span>
      <h3>{{ p.data.title }}</h3>
      <p class="muted">{% if p.data.period %}기간 {{ p.data.period }}{% endif %}{% if p.data.target %} · 대상 {{ p.data.target }}{% endif %}</p>
    </a>
    {%- endfor %}
  </div>
  {%- else %}
  <p class="empty">교육 프로그램을 준비하고 있습니다.</p>
  {%- endif %}
</section>

<section id="field" class="wrap sec">
  <div class="stack">
    <p class="eyebrow">현장지원·위탁</p>
    <h2 class="h2">현장에서 함께한 사업</h2>
  </div>
  {%- if collections.projects.length %}
  <div class="tiles">
    {%- for p in collections.projects %}
    <a href="{{ p.url }}" class="tile">
      <div class="ph-img">{% if p.data.image %}<img src="{{ p.data.image }}" alt="" loading="lazy">{% else %}사진 준비 중{% endif %}</div>
      <b>{{ p.data.title }}</b>
      <span class="muted" style="font-size: 14px">{{ [p.data.region, p.data.period, p.data.client] | select | join(" · ") }}</span>
    </a>
    {%- endfor %}
  </div>
  {%- else %}
  <p class="empty">현장 사업 사례를 준비하고 있습니다.</p>
  {%- endif %}
</section>
