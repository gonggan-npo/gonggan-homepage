<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.name %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.intro }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.intro }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/og.jpg">
<meta property="og:site_name" content="{{ site.name }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png?v=2">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png?v=2">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png?v=2">
<meta name="theme-color" content="#128571">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Sans+KR:wght@400;500;700&display=swap">
<link rel="stylesheet" href="/assets/style.css">
<script src="/assets/motion.js" defer></script>
</head>
<body>
<a class="sr-only" href="#main">본문 바로가기</a>
<header class="hd">
  <div class="wrap hd-in">
    <a href="/" class="logo" aria-label="사단법인 공간 홈"><b>사단법인 공간</b><i>空間</i></a>
    <nav class="nav" aria-label="주 메뉴">
      {%- for item in nav %}
      <a href="{{ item.url }}"{% if section == item.key %} class="on" aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <a href="/contact/" class="btn sm hd-cta">문의하기</a>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="ft">
  <div class="wrap ft-in">
    <div>
      <span class="ft-name">{{ site.name }}</span>
      <span>이사장 {{ site.chair }} · 고유번호 {{ site.regno }}</span>
      <span>{{ site.address }}</span>
      <span>이메일 {{ site.email }}</span>
    </div>
    <div>
      <a href="/privacy/" style="font-weight: 700">개인정보처리방침</a>
      <span class="muted">© {{ site.name }}</span>
    </div>
  </div>
</footer>
</body>
</html>
