<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.name %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.intro }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.intro }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Sans+KR:wght@400;500;700&display=swap">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<a class="sr-only" href="#main">본문 바로가기</a>
<header class="hd">
  <div class="wrap hd-in">
    <a href="/" class="logo" aria-label="사단법인 공간 홈"><small>사단법인</small><b>공간 <i>空間</i></b></a>
    <nav class="nav" aria-label="주 메뉴">
      {%- for item in nav %}
      <a href="{{ item.url }}"{% if section == item.key %} class="on" aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      <a href="/about/#contact" class="btn sm">문의하기</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="ft">
  <div class="wrap ft-in">
    <div>
      <span class="ft-name">{{ site.name }}</span>
      <span>이사장 {{ site.chair }} · 고유번호 {{ site.regno }}</span>
      <span>{{ site.address }}</span>
      <span>이메일 {{ site.email }}</span>
    </div>
    <div>
      <a href="/privacy/" style="font-weight: 700">개인정보처리방침</a>
      <a href="/about/#contact">오시는 길</a>
      <span class="muted">© {{ site.name }}</span>
    </div>
  </div>
</footer>
</body>
</html>
