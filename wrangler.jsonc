// 사단법인 공간 홈페이지 — Cloudflare Worker 설정
// 받는 주소(CONTACT_TO)는 공개 저장소에 두지 않고 Cloudflare 대시보드 변수로 넣습니다.
{
  "name": "gonggan-homepage",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "gonggan.org", "custom_domain": true },
    { "pattern": "www.gonggan.org", "custom_domain": true }
  ],
  "send_email": [{ "name": "MAIL" }],
  "keep_vars": true,
  "observability": { "enabled": true }
}
